<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Panther.Core.ViewModels"
             x:Class="Panther.App.Pages.NowPlayingPage"
             x:DataType="vm:NowPlayingViewModel">

    <Grid RowDefinitions="*,Auto,*">
        <StackPanel Grid.Row="1"
                    HorizontalAlignment="Center"
                    Spacing="16">
            <Border Width="200" Height="200"
                    CornerRadius="8"
                    Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"/>
            <TextBlock Text="No track playing"
                       HorizontalAlignment="Center"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Opacity="0.6"/>
        </StackPanel>
    </Grid>

</UserControl>
