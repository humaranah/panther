<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Panther.WindowsApp.Components.Navigation.NavigationControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Panther.WindowsApp.Components.Navigation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <DataTemplate x:Key="NavigationItemTemplate" x:DataType="local:NavigationItemViewModel">
            <NavigationViewItem Tag="{x:Bind Tag}"
                                MenuItemsSource="{x:Bind SubItems}">
                <StackPanel Style="{StaticResource NavigationItemStackPanel}">
                    <FontIcon Style="{StaticResource NavigationFontIcon}"
                              Glyph="{x:Bind Icon}" />
                    <TextBlock Style="{StaticResource NavigationTextBlock}"
                               Text="{x:Bind LocalizedText}" />
                </StackPanel>
            </NavigationViewItem>
        </DataTemplate>

        <DataTemplate x:Key="NavigationSeparatorTemplate" x:DataType="local:NavigationItemViewModel">
            <NavigationViewItemSeparator />
        </DataTemplate>

        <local:NavigationItemTemplateSelector x:Key="NavigationItemTemplateSelector"
                                                  ItemTemplate="{StaticResource NavigationItemTemplate}"
                                                  SeparatorTemplate="{StaticResource NavigationSeparatorTemplate}" />
    </UserControl.Resources>

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WindowStates">
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="NavView.IsPaneToggleButtonVisible" Value="True" />
                        <Setter Target="NavView.PaneDisplayMode" Value="LeftMinimal" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="600" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="NavView.IsPaneToggleButtonVisible" Value="False" />
                        <Setter Target="NavView.PaneDisplayMode" Value="Top" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <NavigationView x:Name="NavView"
                        Grid.Row="1"
                        Grid.RowSpan="2"
                        PaneDisplayMode="Top"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="True"
                        OpenPaneLength="240"
                        MenuItemsSource="{x:Bind ViewModel.MenuItems, Mode=OneWay}"
                        MenuItemTemplateSelector="{StaticResource NavigationItemTemplateSelector}"
                        ItemInvoked="NavView_ItemInvoked">

            <Frame x:Name="ContentFrame"/>
        </NavigationView>
    </Grid>
</UserControl>
