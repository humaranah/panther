<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Panther.WindowsApp.Views.Controls.PlayerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Panther.WindowsApp.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Panther.WindowsApp.ViewModels"
    xmlns:cv="using:Panther.WindowsApp.Converters"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance vm:PlayerViewModel}">

    <UserControl.Resources>
        <cv:SecondsToTimeConverter x:Key="SecondsToTime" />
    </UserControl.Resources>

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WindowStates">
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="TrackInfo.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="600" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="TrackInfo.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="14" />
            <RowDefinition Height="4" />
            <RowDefinition Height="14" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <Grid x:Name="TrackInfo" Grid.Row="2" Grid.RowSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            
            <!-- Album Art Image -->
            <Border Grid.RowSpan="2"
                    BorderThickness="0"
                    Background="{ThemeResource LayerOnMicaBaseAltFillColorSecondary}">
                <Image Source="{x:Bind ViewModel.AlbumArt}"
                       Stretch="Uniform" />
            </Border>

            <!-- Track Title -->
            <TextBlock Grid.Column="1"
                       Margin="4,1"
                       VerticalAlignment="Bottom"
                       HorizontalTextAlignment="Left"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Text="{x:Bind ViewModel.TrackTitle}" />
            
            <!-- Track Artist -->
            <TextBlock Grid.Column="1"
                       Grid.Row="1"
                       Margin="4,1"
                       VerticalAlignment="Top"
                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                       HorizontalTextAlignment="Left"
                       Text="{x:Bind ViewModel.TrackArtist}" />
        </Grid>

        <!-- Playback Progress Slider -->
        <Slider Grid.ColumnSpan="5"
                Grid.RowSpan="3"
                IsEnabled="{x:Bind ViewModel.IsTrackLoaded, Mode=OneWay}"
                Minimum="0"
                Maximum="{x:Bind ViewModel.TotalDuration, Mode=OneWay}"
                Value="{x:Bind ViewModel.CurrentPosition, Mode=TwoWay}"
                IsThumbToolTipEnabled="{x:Bind ViewModel.IsTrackLoaded, Mode=OneWay}"
                ThumbToolTipValueConverter="{StaticResource SecondsToTime}"/>

        <!-- Player Controls -->
        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
            
            <!-- Shuffle Button -->
            <ToggleButton Style="{StaticResource PlayerFlat40ToggleButtonStyle}"
                          IsChecked="{x:Bind ViewModel.IsShuffleActive, Mode=TwoWay}">
                <FontIcon Style="{StaticResource PlayerButtonPathIcon}"
                          Glyph="{x:Bind cv:GlyphConverters.GetShuffleGlyph(ViewModel.IsShuffleActive), Mode=OneWay}" />
            </ToggleButton>
            
            <!-- Previous Button -->
            <Button Style="{StaticResource PlayerFlat48ButtonStyle}"
                    Command="{x:Bind ViewModel.PreviousTrackCommand}">
                <FontIcon Style="{StaticResource PlayerButtonPathIcon}"
                          Glyph="&#xEEA1;" />
            </Button>
            
            <!-- Play Button -->
            <Button Style="{StaticResource PlayerFlatPlayButtonStyle}"
                    Command="{x:Bind ViewModel.PlayPauseCommand}">
                <Border BorderThickness="1.3"
                        CornerRadius="24"
                        Width="48"
                        Height="48"
                        Margin="0,2"
                        BorderBrush="{Binding Foreground, ElementName=PlayGlyph}">
                    <FontIcon x:Name="PlayGlyph"
                              Style="{StaticResource PlayerButtonPathIcon}"
                              Glyph="{x:Bind cv:GlyphConverters.GetPlayPauseGlyph(ViewModel.IsPlaying), Mode=OneWay}"/>
                </Border>
            </Button>
            
            <!-- Next Button -->
            <Button Style="{StaticResource PlayerFlat48ButtonStyle}"
                    Command="{x:Bind ViewModel.NextTrackCommand}">
                <FontIcon Style="{StaticResource PlayerButtonPathIcon}"
                          Glyph="&#xE82D;" />
            </Button>
            
            <!-- Repeat Button -->
            <ToggleButton Style="{StaticResource PlayerFlat40ToggleButtonStyle}"
                          IsChecked="{x:Bind ViewModel.IsRepeatActive, Mode=OneWay}"
                          Command="{x:Bind ViewModel.ToggleRepeatCommand}">
                <FontIcon Style="{StaticResource PlayerButtonPathIcon}"
                          Glyph="{x:Bind cv:GlyphConverters.GetRepeatGlyph(ViewModel.RepeatMode), Mode=OneWay}" />
            </ToggleButton>
        </StackPanel>

        <StackPanel Grid.Column="2"
                    Grid.Row="2"
                    Grid.RowSpan="2"
                    Margin="0,0,80,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">

            <ToggleButton Style="{StaticResource PlayerFlat40ToggleButtonStyle}"
                          Margin="0"
                          IsChecked="{x:Bind ViewModel.IsMuted, Mode=TwoWay}">
                <FontIcon Style="{StaticResource PlayerButtonPathIcon}"
                          Glyph="{x:Bind cv:GlyphConverters.GetVolumeGlyph(ViewModel.IsMuted, ViewModel.VolumePercent), Mode=OneWay}" />
            </ToggleButton>

            <Slider Width="120"
                    VerticalAlignment="Center"
                    Minimum="0"
                    Maximum="100"
                    SmallChange="1"
                    LargeChange="10"
                    TickFrequency="50"
                    TickPlacement="Outside"
                    Value="{x:Bind ViewModel.VolumePercent}"
                    IsThumbToolTipEnabled="True"/>
        </StackPanel>
    </Grid>
</UserControl>
